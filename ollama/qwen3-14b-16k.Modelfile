# qwen3:14b with a 16k context window. AgentDojo prompts + tool outputs overflow
# Ollama's 4k default, which silently truncates the conversation.
# Fits in 16 GB of VRAM (~9 GB weights + 16k context).
# Build: ollama create qwen3-14b-16k -f ollama/qwen3-14b-16k.Modelfile
FROM qwen3:14b
PARAMETER num_ctx 16384
